# Copia questo file in .env e compila i valori

# Anthropic API Key (obbligatoria)
# Ottienila su https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# WordPress / WooCommerce
WP_URL=https://tuosito.it
WP_USER=admin
WP_PASSWORD=la_tua_password

# Portali B2B — credenziali per login automatico
# L'agente le usa senza chiederti niente in chat

# AZ Car B2B
AZCAR_URL=https://b2b.azcar.it
AZCAR_USER=la_tua_email@esempio.it
AZCAR_PASSWORD=la_tua_password

# Elring (opzionale se richiede login)
ELRING_URL=https://www.elring.de
ELRING_USER=
ELRING_PASSWORD=

# Corteco (opzionale)
CORTECO_URL=https://www.corteco.com
CORTECO_USER=
CORTECO_PASSWORD=

# Valeo (opzionale)
VALEO_URL=https://www.valeo.com
VALEO_USER=
VALEO_PASSWORD=

# AutoDoc (opzionale)
AUTODOC_URL=https://www.autodoc.it
AUTODOC_USER=
AUTODOC_PASSWORD=

# Prezzi (opzionali — questi sono i default)
MARGINE_PERCENTUALE=30
ALIQUOTA_IVA=22

# Server (opzionali — questi sono i default)
HOST=127.0.0.1
PORT=8000
