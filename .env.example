# Copia questo file in .env e compila i valori

# Anthropic API Key (obbligatoria)
# Ottienila su https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# WordPress / WooCommerce
WP_URL=https://tuosito.it
WP_USER=admin
WP_PASSWORD=la_tua_password

# Prezzi (opzionali — questi sono i default)
MARGINE_PERCENTUALE=30
ALIQUOTA_IVA=22

# Server (opzionali — questi sono i default)
HOST=127.0.0.1
PORT=8000
